IPHONE_USE_DIR="$HOME/path/to/iphone-use"
OPENCLAW_AGENT_ID="liangjiu-promotion"
OPENCLAW_WORKSPACE="$HOME/.openclaw/workspace-liangjiu-promotion"

WECHAT_IPHONE_PROJECT_DIR="$IPHONE_USE_DIR"
WECHAT_IPHONE_CONFIG="$IPHONE_USE_DIR/config/allowed-groups.json"
WECHAT_IPHONE_TARGET_GROUP="<TARGET_WECHAT_GROUP>"
WECHAT_IPHONE_SCREEN_WIDTH="393"
WECHAT_IPHONE_SCREEN_HEIGHT="852"

WDA_TEAM_ID="<APPLE_TEAM_ID>"
WDA_UDID="<IPHONE_UDID>"

