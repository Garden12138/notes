# Copy only the values you need into a private shell profile or local env file.
# Do not commit real identifiers, group names, tokens, or product data.

OPENCLAW_AGENT_ID="<AGENT_NAME>"
OPENCLAW_WORKSPACE="$HOME/.openclaw/workspace-youzan-promotion"
IPHONE_USE_DIR="$HOME/path/to/iphone-use"

WECHAT_IPHONE_PROJECT_DIR="$IPHONE_USE_DIR"
WECHAT_IPHONE_CONFIG="$OPENCLAW_WORKSPACE/skills/wechat-iphone/config/allowed-groups.json"
WECHAT_IPHONE_TARGET_GROUP="<TARGET_WECHAT_GROUP>"
WECHAT_IPHONE_TOKEN_FILE="$HOME/.iphone-use/agent-token"
WECHAT_TASK_ROOT="$HOME/.iphone-use/wechat-iphone/tasks"

WDA_TEAM_ID="<APPLE_TEAM_ID>"
WDA_UDID="<IPHONE_UDID>"

# Calibrate these normalized coordinates from the current device element tree.
WECHAT_IPHONE_SEARCH_X="0.50"
WECHAT_IPHONE_SEARCH_Y="0.12"
WECHAT_IPHONE_FIRST_RESULT_X="0.50"
WECHAT_IPHONE_FIRST_RESULT_Y="0.20"
WECHAT_IPHONE_INPUT_X="0.50"
WECHAT_IPHONE_INPUT_Y="0.93"

